        "toEmail": "REPLACE_WITH_RECIPIENT_EMAIL",
        "subject": "={{ `[${$json.body.data.priority}] Reorder alert: ${$json.body.data.productName}` }}",
        "emailFormat": "text",
        "text": "={{ `High-priority inventory alert\n\n${$json.body.data.productName} (${ $json.body.data.productId }) needs attention.\n\nPriority: ${$json.body.data.priority}\nCategory: ${$json.body.data.category}\nCurrent stock: ${$json.body.data.currentStock}\nMinimum stock: ${$json.body.data.minimumStock}\nForecast demand (${ $json.body.data.forecastHorizonDays } days): ${$json.body.data.forecastDemand} units\nSafety stock: ${$json.body.data.safetyStock} units\nOn order: ${$json.body.data.onOrder} units\nSuggested reorder: ${$json.body.data.reorderQuantity} units\nEstimated cost: ${$json.body.data.estimatedCost}\n\nReason: ${$json.body.data.reason}\nAlert time: ${$json.body.occurredAt}` }}",
        "options": {}
      },
      "id": "461ef38c-0871-4a53-b40d-174d0c5ab4c3",
      "name": "Send Reorder Email",
