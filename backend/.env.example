# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# A replica set (or Atlas) is recommended so multi-document transactions work.
# `npm run db:start` starts a local single-node replica set on this address.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_inventory?replicaSet=rs0

# ---- Authentication ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Seeded admin user (used only by `npm run seed:admin` / `npm run import`) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@smartinventory.local
ADMIN_PASSWORD=change_me_admin_password

# ---- Machine learning (Python) ----
# Leave PYTHON_PATH empty to auto-detect backend/ml/.venv/bin/python, then python3.
PYTHON_PATH=
ML_TIMEOUT_MS=180000
FORECAST_HORIZON_DAYS=30

# ---- Reorder logic ----
# Safety stock = SAFETY_Z * stdDev(daily demand) * sqrt(LEAD_TIME_DAYS)
SAFETY_Z=1.65
LEAD_TIME_DAYS=7
SAFETY_WINDOW_DAYS=30
